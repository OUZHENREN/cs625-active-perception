  </gazebo>
  <gazebo reference="gripper_base_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="gripper_left_finger_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="gripper_right_finger_link">
    <gravity>false</gravity>
  </gazebo>
  <!-- Preserved from the senior CS625 description so the existing MoveIt
       SRDF group (tip=my_end_effector_link) remains usable. -->
  <link name="my_end_effector_link">
    <visual>
      <geometry>
        <mesh filename="file://${CS625_UNDERLAY_INSTALL}/eli_cs_robot_description/share/eli_cs_robot_description/meshes/visual/tool0_vision.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="eef_color">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
