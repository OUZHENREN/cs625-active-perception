    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to CS 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Keep the senior top-level Gazebo model pattern, but spell out the
         Humble gz_ros2_control parameter source so the embedded plugin does
         not depend on discovery timing. -->
  <gazebo reference="world"/>
  <gazebo>
    <!-- Humble/Fortress expects the plugin's exported logical filename.
           The installed ELF remains libgz_ros2_control-system.so. -->
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters></parameters>
      <!-- gz_ros2_control maps the position interface to a velocity
             setpoint.  Its default 0.1 gain leaves the heavy CS625 fixture
             materially behind a retimed P7 trajectory; 0.5 is within the
             Jazzy documented non-oscillatory range (<= 1) and is simulation
             only. -->
      <position_proportional_gain>0.5</position_proportional_gain>
      <controller_manager_name>controller_manager</controller_manager_name>
    </plugin>
  </gazebo>
  <!-- P7 validates task geometry and controller/TF consistency, not
         force-accurate robot dynamics.  Make the robot's own articulated
         links gravity-free so a position command is not torque-saturated by
         the synthetic arm mass.  The YCB target remains dynamic in the world
         and the attachment mechanism is still explicitly labelled kinematic.
         This never applies to a real-robot profile. -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="shoulder_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="upperarm_link">
