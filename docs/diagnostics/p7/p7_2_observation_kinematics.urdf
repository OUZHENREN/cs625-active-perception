      </geometry>
    </collision>
  </link>
  <joint name="flange_to_eef_joint" type="fixed">
    <parent link="flange"/>
    <child link="my_end_effector_link"/>
    <origin rpy="0 0 0" xyz="-0.046 0 0.353"/>
  </joint>
  <!-- Stable application frame used by the active-perception contract. -->
  <link name="tool0"/>
  <joint name="eef_to_tool0" type="fixed">
    <parent link="my_end_effector_link"/>
    <child link="tool0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.080 0.090 0.050"/>
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.18 0.18 0.18 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.080 0.090 0.050"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.00020" ixy="0" ixz="0" iyy="0.00017" iyz="0" izz="0.00028"/>
    </inertial>
  </link>
  <joint name="tool0_to_gripper_base" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base_link"/>
    <origin rpy="0 0 0" xyz="0.085 0 0"/>
  </joint>
  <link name="gripper_right_finger_link">
    <visual>
      <origin xyz="0.045 0 0"/>
      <geometry>
        <box size="0.090 0.014 0.070"/>
      </geometry>
      <material name="gripper_finger">
        <color rgba="0.32 0.32 0.32 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.045 0 0"/>
      <geometry>
        <box size="0.090 0.014 0.070"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.045 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
  </link>
  <joint name="gripper_right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger_link"/>
    <origin rpy="0 0 0" xyz="0.005 -0.018 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="80" lower="0.0" upper="0.040" velocity="0.10"/>
  </joint>
  <link name="gripper_left_finger_link">
    <visual>
      <origin xyz="0.045 0 0"/>
      <geometry>
        <box size="0.090 0.014 0.070"/>
      </geometry>
      <material name="gripper_finger_left">
        <color rgba="0.32 0.32 0.32 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.045 0 0"/>
      <geometry>
        <box size="0.090 0.014 0.070"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.045 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
  </link>
  <joint name="gripper_left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger_link"/>
    <origin rpy="0 0 0" xyz="0.005 0.018 0"/>
    <axis xyz="0 1 0"/>
    <mimic joint="gripper_right_finger_joint" multiplier="1.0" offset="0.0"/>
    <limit effort="80" lower="0.0" upper="0.040" velocity="0.10"/>
  </joint>
  <ros2_control name="cs625_parallel_gripper" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.030</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="gripper_left_finger_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <!-- Nominal cylindrical-object grasp centre between the two finger pads.
       The pad volumes span x=0.005..0.095 m from gripper_base_link, while the
       palm collision ends at x=0.040 m.  Placing the reference at x=0.080 m
       leaves 6 mm clearance behind the 34 mm-radius tomato-can proxy; the old
       pad-volume midpoint at x=0.050 m overlapped the palm and pushed the can.
       The link is massless and collision-free and remains centred laterally
       while the two prismatic fingers move symmetrically. -->
  <link name="p7_grasp_center_link"/>
  <joint name="gripper_base_to_p7_grasp_center" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="p7_grasp_center_link"/>
    <origin rpy="0 0 0" xyz="0.080 0 0"/>
  </joint>
  <link name="camera_mount_link">
    <inertial>
      <mass value="0.01"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <joint name="tool0_to_camera_mount" type="fixed">
    <parent link="tool0"/>
    <child link="camera_mount_link"/>
    <origin rpy="0 0.785398163397 0" xyz="0.03 0 0.15"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.05 0.02"/>
      </geometry>
      <material name="camera_body">
        <color rgba="0.20 0.20 0.20 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.05 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_mount_to_camera" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_to_depth_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin rpy="-1.570796326795 0 -1.570796326795" xyz="0 0 0"/>
  </joint>
  <!-- RGB-D consumers need a color optical frame as well as the depth
         optical frame. Both are fixed descendants of the reusable camera
         body frame, matching the senior eye-in-hand layout. -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_to_color_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin rpy="-1.570796326795 0 -1.570796326795" xyz="0 0 0"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>10.0</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
        <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
      </camera>
      <topic>/camera</topic>
    </sensor>
  </gazebo>
</robot>
