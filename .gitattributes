# Auto detect text files and perform LF normalization
* text=auto

# ROS2 source files — force LF on checkout, LF on commit
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.xml text eol=lf
*.xacro text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.launch.py text eol=lf
*.sh text eol=lf
*.sdf text eol=lf
*.repos text eol=lf
*.msg text eol=lf
*.srv text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
