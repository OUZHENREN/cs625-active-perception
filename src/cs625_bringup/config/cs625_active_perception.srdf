<?xml version="1.0"?>
<!--
  Application semantic overlay for the reused CS625 MoveIt configuration.
  The arm group, virtual joint, and original disabled-collision pairs are
  preserved verbatim.  The three final pairs cover the application-owned
  parallel gripper's mechanically adjacent links; without them MoveIt marks
  the nominal open-gripper state as self-collision and rejects all IK calls
  made with avoid_collisions=true.
-->
<robot name="cs625">
  <group name="cs625_arm">
    <chain base_link="base_link" tip_link="my_end_effector_link"/>
  </group>
  <group_state group="cs625_arm" name="home">
    <joint name="elbow_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="0"/>
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="0"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <virtual_joint child_link="base_link" name="virtual_joint" parent_frame="world" type="fixed"/>

  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="upperarm_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <!-- 两份描述共用这一份 SRDF，而它们把工具网格挂在**不同**的 link 上：
         · 本仓库 cs625_ap_description（仿真用）：网格在 tool0（与法兰重合）
         · 厂商 eli_cs_robot_description（真机 MoveIt 用）：网格在 my_end_effector_link
       所以两组豁免都要留着。对某一份描述里不存在的 link，MoveIt 只会忽略该条，
       而少了主人在的那一组，就会把"工具贴着腕部"判成自碰撞，MoveIt 直接拒绝规划
       （真机上表现为模型全红）。2026-10-25 改坐标系时曾只留 tool0 一组，
       被审查发现会让真机侧六条豁免全部失效，故补回 my_end_effector_link 一组。 -->
  <disable_collisions link1="tool0" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="my_end_effector_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="my_end_effector_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="my_end_effector_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>

  <disable_collisions link1="gripper_base_link" link2="gripper_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_finger_link" link2="gripper_right_finger_link" reason="Never"/>
  <!-- tool0 carries the REAL tool mesh, which already contains the support arms.
       The two finger links are kinematic placeholders that sit inside that mesh, so
       without these pairs MoveIt reports a self-collision and every view of the
       robot draws the tool in red.  They can never legitimately collide: the slabs
       span +/-102..147 mm and the mesh spans +/-147 mm, so the fingers stay inside
       the body at any joint value.

       2026-10-25: the mesh hangs on tool0 (a frame on the flange) rather than on
       my_end_effector_link, because my_end_effector_link is now the real
       controller's TCP, 353 mm out along the tool axis, and carries no geometry.
       Tying these exemptions to the link that owns the geometry is what keeps
       CheckStartStateCollision from aborting every plan. -->
  <disable_collisions link1="tool0" link2="gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_left_finger_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="gripper_right_finger_link" reason="Never"/>
</robot>
