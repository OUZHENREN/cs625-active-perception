<?xml version="1.0"?>
<!-- Keep the robot name identical to the reused senior SRDF/MoveIt model. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cs625">
  <!--
    Application wrapper around the reusable CS robot macro from the senior /
    official description package. The robot links and dynamics remain in the
    underlay; this file only composes them with the task-specific tool and
    camera chain.
  -->
  <xacro:include filename="$(find eli_cs_robot_description)/urdf/cs_macro.xacro"/>
  <xacro:include filename="$(find cs625_ap_description)/urdf/cs625_camera_extension.xacro"/>
  <xacro:include filename="$(find cs625_ap_description)/urdf/cs625_parallel_gripper.xacro"/>

  <xacro:arg name="name" default="cs625"/>
  <xacro:arg name="cs_type" default="cs625"/>
  <!-- The senior simulation launch passes `prefix`; the official real driver
       passes `tf_prefix`. Supporting both keeps one application description. -->
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="prefix" default="$(arg tf_prefix)"/>
  <xacro:arg name="joint_limit_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/visual_parameters.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find eli_cs_robot_description)/config/initial_positions.yaml"/>

  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="sim_ignition" default="false"/>
  <!-- Keep the senior sensor's Gazebo topic contract as the compatibility
       default. The ROS-facing name is assigned by the bridge profile. -->
  <xacro:arg name="camera_sensor_topic" default="/camera"/>
  <xacro:arg name="camera_image_width" default="320"/>
  <xacro:arg name="camera_image_height" default="240"/>
  <xacro:arg name="camera_update_rate" default="10.0"/>
  <xacro:arg name="camera_enabled" default="true"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="p7_attachment_enabled" default="true"/>
  <xacro:arg name="headless_mode" default="false"/>

  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="script_filename" default=""/>
  <xacro:arg name="output_recipe_filename" default=""/>
  <xacro:arg name="input_recipe_filename" default=""/>
  <xacro:arg name="local_ip" default="0.0.0.0"/>
  <xacro:arg name="script_command_port" default="50004"/>
  <xacro:arg name="reverse_port" default="50001"/>
  <xacro:arg name="script_sender_port" default="50002"/>
  <xacro:arg name="trajectory_port" default="50003"/>
  <xacro:arg name="use_tool_communication" default="false"/>
  <xacro:arg name="tool_voltage" default="0"/>
  <xacro:arg name="tool_parity" default="0"/>
  <xacro:arg name="tool_baud_rate" default="115200"/>
  <xacro:arg name="tool_stop_bits" default="1"/>
  <xacro:arg name="tool_tcp_port" default="54321"/>

  <!-- Real eye-in-hand calibration, not a tuned guess.  These are what
       RobotVisionSuite's hand-eye calibration produced, expressed in the FLANGE
       frame.  src/cs625_bringup/config/camera_extrinsics_sim.yaml carries the same
       numbers with their provenance and is the authority; test/contract_checks.py
       fails when the two drift apart.  Regenerate with scripts/camera_extrinsics.py
       rather than editing by hand.

       What changed and why.  The previous default was (0.03, 0, 0.15) tilted 45
       degrees, tuned against the placeholder gripper so that P7.1's marker stayed
       out of the palm's shadow.  The real camera looks straight down the tool axis
       from about 97 mm out.  P7.1's sensor gate was therefore re-run against this
       pose; its earlier evidence belonged to the placeholder and is not current.

       camera_link anchors on the DEPTH eye so that the Gazebo rgbd_camera, which
       looks along camera_link +X, coincides exactly with
       camera_depth_optical_frame.  The colour eye sits 24.411 mm away. -->
  <xacro:arg name="camera_mount_xyz" default="0.096754 0.017803 0.097328"/>
  <xacro:arg name="camera_mount_rpy" default="3.049945177808 -1.568363463268 -3.059531774309"/>
  <!-- camera_link uses the usual body convention; optical is x-right,
       y-down, z-forward. -->
  <xacro:arg name="camera_optical_rpy" default="-1.570796326795 0 -1.570796326795"/>
  <xacro:arg name="camera_color_xyz" default="0.000206656525 0.024409803932 0.000037497526"/>
  <xacro:arg name="camera_color_rpy" default="-1.573876346752 -0.003322338011 -1.584268392311"/>

  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>

  <link name="world"/>

  <xacro:cs_robot
    name="$(arg name)"
    tf_prefix="$(arg prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"
    sim_gazebo="$(arg sim_gazebo)"
    sim_ignition="$(arg sim_ignition)"
    headless_mode="$(arg headless_mode)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"
    robot_ip="$(arg robot_ip)"
    script_filename="$(arg script_filename)"
    output_recipe_filename="$(arg output_recipe_filename)"
    input_recipe_filename="$(arg input_recipe_filename)"
    local_ip="$(arg local_ip)"
    script_command_port="$(arg script_command_port)"
    reverse_port="$(arg reverse_port)"
    script_sender_port="$(arg script_sender_port)"
    trajectory_port="$(arg trajectory_port)"
    use_tool_communication="$(arg use_tool_communication)"
    tool_voltage="$(arg tool_voltage)"
    tool_parity="$(arg tool_parity)"
    tool_baud_rate="$(arg tool_baud_rate)"
    tool_stop_bits="$(arg tool_stop_bits)"
    tool_tcp_port="$(arg tool_tcp_port)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:cs_robot>


  <!-- Reused from the senior CS625 description. The control plugin belongs
       at the top-level robot description, while the reusable cs_robot macro
       owns the ros2_control tag itself. -->
  <xacro:if value="$(arg sim_gazebo)">
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
  <xacro:if value="$(arg sim_ignition)">
    <!-- Keep the senior top-level Gazebo model pattern, but spell out the
         Humble gz_ros2_control parameter source so the embedded plugin does
         not depend on discovery timing. -->
    <gazebo reference="world"/>
    <gazebo>
      <!-- Humble/Fortress expects the plugin's exported logical filename.
           The installed ELF remains libgz_ros2_control-system.so. -->
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(arg simulation_controllers)</parameters>
        <!-- gz_ros2_control maps the position interface to a velocity
             setpoint.  Its default 0.1 gain leaves the heavy CS625 fixture
             materially behind a retimed P7 trajectory; 0.5 is within the
             Jazzy documented non-oscillatory range (<= 1) and is simulation
             only. -->
        <position_proportional_gain>0.5</position_proportional_gain>
        <controller_manager_name>$(arg prefix)controller_manager</controller_manager_name>
      </plugin>
      <!-- P7 attachment-assisted grasp mechanism.  Gazebo's official
           DetachableJoint starts attached, so a P7 episode must explicitly
           publish /p7/attachment/detach during reset and may only publish
           /p7/attachment/attach after its geometric pre-grasp gate passes.
           This is an attachment state, not evidence of frictional contact. -->
      <xacro:if value="$(arg p7_attachment_enabled)">
        <plugin filename="gz-sim-detachable-joint-system"
                name="gz::sim::systems::DetachableJoint">
        <!-- Gazebo collapses the fixed tool / gripper chain when converting
             the URDF; wrist_3_link is the terminal non-lumped actuated link
             that remains addressable in the running CS625 model. -->
        <parent_link>$(arg prefix)wrist_3_link</parent_link>
        <child_model>target_object</child_model>
        <child_link>target_link</child_link>
        <detach_topic>/p7/attachment/detach</detach_topic>
        <attach_topic>/p7/attachment/attach</attach_topic>
          <output_topic>/p7/attachment/state</output_topic>
        </plugin>
      </xacro:if>
    </gazebo>
    <!-- P7 validates task geometry and controller/TF consistency, not
         force-accurate robot dynamics.  Make the robot's own articulated
         links gravity-free so a position command is not torque-saturated by
         the synthetic arm mass.  The YCB target remains dynamic in the world
         and the attachment mechanism is still explicitly labelled kinematic.
         This never applies to a real-robot profile. -->
    <gazebo reference="$(arg prefix)base_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)shoulder_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)upperarm_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)forearm_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)wrist_1_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)wrist_2_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)wrist_3_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)my_end_effector_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)gripper_base_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)gripper_left_finger_link"><gravity>false</gravity></gazebo>
    <gazebo reference="$(arg prefix)gripper_right_finger_link"><gravity>false</gravity></gazebo>
  </xacro:if>

  <!-- The real tool, exported from SolidWorks in the FLANGE frame: the origin is
       the mounting face, X is the gripper's symmetry axis, and +Z runs out along
       the tool.  Two independent checks say so: X is symmetric to 0.000 mm
       (-147.285 .. +147.285), and Z runs -7.0 mm (a locating boss behind the face)
       to +207.0 mm.  The mesh is already in metres, so no scale attribute.

       This replaces the senior's tool0_vision.STL, which was a DIFFERENT object
       (177 x 240 x 214 mm against 294.6 x 85 x 214 mm), was an ASCII mesh of
       50 MB with 183373 triangles, and sat 146..360 mm off its own origin, which
       is where the old -0.046 0 0.353 joint offset came from.  The joint below is
       therefore identity: the tool's own frame is the flange frame.

       Inertia is the SolidWorks positive-tensor output, converted at 1e-6 and
       rotated from the part frame into this one; the mass is the measured
       4.580 kg.  The centre of mass X is -0.10 mm, which the symmetry check above
       predicts.  The SRDF tip stays my_end_effector_link, so the group, the P7
       contracts and the MoveIt configuration are untouched. -->
  <link name="$(arg prefix)my_end_effector_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find cs625_ap_description)/meshes/tool/gripper_0920.stl"/>
      </geometry>
      <material name="eef_color"><color rgba="0.75 0.75 0.75 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find cs625_ap_description)/meshes/tool/gripper_0920.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0001013 0.0140800 0.1095589" rpy="0 0 0"/>
      <mass value="4.580"/>
      <inertia ixx="1.656126300e-02" ixy="4.500000000e-07" ixz="4.718400000e-05"
               iyy="3.412100900e-02" iyz="-6.521470000e-04" izz="2.090739800e-02"/>
    </inertial>
  </link>
  <joint name="$(arg prefix)flange_to_eef_joint" type="fixed">
    <parent link="$(arg prefix)flange"/>
    <child link="$(arg prefix)my_end_effector_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Stable application frame used by the active-perception contract. -->
  <link name="$(arg prefix)tool0"/>
  <joint name="$(arg prefix)eef_to_tool0" type="fixed">
    <parent link="$(arg prefix)my_end_effector_link"/>
    <child link="$(arg prefix)tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:cs625_parallel_gripper parent="$(arg prefix)tool0" prefix="$(arg prefix)"/>

  <!-- Grasp centre between the two support arms.  Massless and collision-free.
       The arms are 146 mm tall centred on Z = 77 mm, so this frame sits at the
       middle of the contact area on the tool axis. -->
  <link name="$(arg prefix)p7_grasp_center_link"/>
  <joint name="$(arg prefix)gripper_base_to_p7_grasp_center" type="fixed">
    <parent link="$(arg prefix)gripper_base_link"/>
    <child link="$(arg prefix)p7_grasp_center_link"/>
    <!-- Between the two support arms, on the tool axis.  The old 0.080 m along X
         was the placeholder jaw's pad centre and pointed along the wrong axis. -->
    <origin xyz="0 0 0.077" rpy="0 0 0"/>
  </joint>

  <xacro:cs625_eye_in_hand_camera
    parent="$(arg prefix)tool0"
    prefix="$(arg prefix)"
    xyz="$(arg camera_mount_xyz)"
    rpy="$(arg camera_mount_rpy)"
    optical_rpy="$(arg camera_optical_rpy)"
    color_xyz="$(arg camera_color_xyz)"
    color_rpy="$(arg camera_color_rpy)"
    sim_ignition="$(arg sim_ignition)"
    camera_sensor_topic="$(arg camera_sensor_topic)"
    camera_image_width="$(arg camera_image_width)"
    camera_image_height="$(arg camera_image_height)"
    camera_update_rate="$(arg camera_update_rate)"
    camera_enabled="$(arg camera_enabled)"/>
</robot>
