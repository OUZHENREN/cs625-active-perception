<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Application gripper FRAMES only.  This is an application extension: it never
    edits the Elite CS625 underlay.

    The box geometry that used to live here was a placeholder: a 0.080 x 0.090 x
    0.050 palm with two 0.090 x 0.014 x 0.070 fingers.  It is not the real tool.
    The real tool is the mesh on my_end_effector_link (tool0_vision.STL /
    tool0_collision.STL), which carries both the gripper and the camera, so the
    boxes were deleted to stop a phantom gripper floating next to the real one.

    The links, the prismatic finger joints and the masses are KEPT on purpose:
      - cs625_active_perception.srdf names these links in disable_collisions,
      - sim_controllers.yaml drives gripper_right_finger_joint,
      - test/apply_task_fixture_scene.py uses FINGER_LINKS by name,
      - the payload budget counts this mass.
    Removing the links would break all four, so only the geometry is gone.

    Masses here are 1 g placeholders.  The measured 4.580 kg of 夹持机构0228 now
    lives on my_end_effector_link, where the real mesh is; leaving it here as well
    would count the tool twice.  The finger stroke below (0..0.040 m) is still a
    placeholder: the real tool braces its handles with 0.00257 m of preload.  See
    config/cs625_task_scene.yaml.
  -->
  <xacro:macro name="cs625_parallel_gripper" params="parent prefix">
    <link name="${prefix}gripper_base_link">
      <!-- placeholder box removed: 0.080 0.090 0.050 m -->
      <inertial><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
      <!-- Massless placeholder: the real 4.580 kg now sits on my_end_effector_link,
           where the real mesh is.  Keeping it here too would double-count it. -->
    </link>
    <joint name="${prefix}tool0_to_gripper_base" type="fixed">
      <parent link="${parent}"/><child link="${prefix}gripper_base_link"/>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_right_finger_link">
      <!-- placeholder box removed: 0.090 0.014 0.070 m -->
      <inertial><origin xyz="0.045 0 0"/><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
    </link>
    <joint name="${prefix}gripper_right_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/><child link="${prefix}gripper_right_finger_link"/>
      <origin xyz="0.005 -0.018 0" rpy="0 0 0"/><axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.040" effort="80" velocity="0.10"/>
    </joint>

    <link name="${prefix}gripper_left_finger_link">
      <!-- placeholder box removed: 0.090 0.014 0.070 m -->
      <inertial><origin xyz="0.045 0 0"/><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
    </link>
    <joint name="${prefix}gripper_left_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/><child link="${prefix}gripper_left_finger_link"/>
      <origin xyz="0.005 0.018 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <mimic joint="${prefix}gripper_right_finger_joint" multiplier="1.0" offset="0.0"/>
      <limit lower="0.0" upper="0.040" effort="80" velocity="0.10"/>
    </joint>

    <ros2_control name="${prefix}cs625_parallel_gripper" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <joint name="${prefix}gripper_right_finger_joint">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.030</param></state_interface>
        <state_interface name="velocity"/><state_interface name="effort"/>
      </joint>
      <joint name="${prefix}gripper_left_finger_joint">
        <state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
