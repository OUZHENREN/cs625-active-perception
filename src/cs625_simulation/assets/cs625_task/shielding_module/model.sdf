<?xml version="1.0"?>
<!--
  Shielding-plate module (弹仓) for the CS625 insertion task.

  Frame: the SolidWorks part frame, unchanged by the export.  The mesh origin is
  NOT the centre of the part; the bounding box runs from (-0.4358, -0.0220,
  -0.2400) to (0.0188, 0.1090, 0.2250) m, and the centre of mass sits at
  (-0.2085, 0.0634, -0.0184) m.

  Mass properties: mass, centre of mass and inertia are the SolidWorks values.
  The mass is user-overridden to 19.0 kg, so the density is a derived figure
  rather than a material property: 19.0 kg over 3.41209164e-3 m^3 is 5568 kg/m^3,
  well above aluminium, consistent with the shielding material inside.

  Only the centre-of-mass position is needed from the geometry, and the measured
  value differs from the mesh's geometric centroid by at most 1.0 mm
  (-208.49 vs -208.502, 63.55 vs 63.361, -19.44 vs -18.444 mm), so the
  uniform-density assumption was adequate there.

  SolidWorks reports the tensor in "positive tensor notation", where
  Lxy = integral(x*y) dm, so the inertia tensor off-diagonal is MINUS Lxy.  That
  convention was verified twice against the parallel-axis theorem, using both the
  gripper and the module's own centre-of-mass and output-frame blocks.

  Values converted from g*mm^2 at 1e-9.  A uniform-density estimate from the mesh
  gave Ixx to -0.2% but Iyy -5.9% and Izz -9.8%, so the measured tensor matters.
-->
<sdf version="1.9">
  <model name="shielding_module">
    <link name="shielding_module_link">
      <inertial>
        <pose>-0.20849 0.06355 -0.01944 0 0 0</pose>
        <mass>19.0</mass>
        <inertia>
          <ixx>3.993602428e-01</ixx>
          <ixy>2.092340000e-05</ixy>
          <ixz>1.099317000e-05</ixz>
          <iyy>7.891516666e-01</iyy>
          <iyz>4.086532080e-03</iyz>
          <izz>4.349741182e-01</izz>
        </inertia>
      </inertial>

      <!-- Collision is the housing body plus the two rails that form the grasp
           groove, NOT the bounding box.

           History, because this file has now been wrong twice in the same
           direction (too much solid material where the gripper must go):

           1. One solid box (0.4546 x 0.13099 x 0.4650 m) used to sit here.  The
              comment above it already said the real part is a 10.9 % fill
              thin-walled housing, so the model contradicted itself.  Measured
              consequence on 2026-10-25: the real pre_grasp trajectory jammed in
              Gazebo with shoulder_lift / wrist_1 / wrist_2 pinned at their
              effort limits (730 / 100 / 100 N m), the physics fell to RTF 0.09
              and every later phase inherited the corrupted arm pose.  A filled
              box covers the groove, so the grasp is physically impossible in
              simulation while the real cell performs it.
           2. Simply using the CAD mesh as <collision> is NOT a fix either:
              dartsim refuses SDF mesh collisions ("Mesh construction from an
              SDF has not been implemented yet for dartsim"), the collision is
              created empty, and the part silently stops colliding altogether -
              which hides the bug instead of fixing it.

           So the groove is modelled explicitly with the measured numbers.  The
           real grasp is an external expansion onto the two rails: the two
           support arms enter the groove between them, then push outward and
           load the rail inner faces.  Measured in the part frame:
             grasp TCP                     = (-0.3235, 0.0829, 0.1793) m
             TCP to nearest part surface   = 26.8 mm (the part +y face)
             rail inner-face free span     = 233 mm across part x
             groove depth                  = 114 mm
             CAD external expansion        = 246.57 mm
           Hence three boxes: the body beyond the groove, the far rail wall, and
           the floor behind the groove, leaving 223.8 mm of free span (the 233 mm
           measurement less the wall taker-up) and a 114 mm deep opening towards
           the part +y face.  The outer envelope of the three boxes is exactly
           the old bounding box, so the slot insertion still sees the same outer
           shape; only the groove became a hole. -->
      <collision name="body">
        <pose>-0.094100 0.043500 -0.007500 0 0 0</pose>
        <geometry>
          <box><size>0.2258 0.1310 0.4650</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
          </friction>
        </surface>
      </collision>
      <!-- The far rail: the surface the lower-x support arm expands against. -->
      <collision name="rail">
        <pose>-0.433300 0.043500 -0.007500 0 0 0</pose>
        <geometry>
          <box><size>0.0050 0.1310 0.4650</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
          </friction>
        </surface>
      </collision>
      <!-- The groove floor is deliberately NOT modelled.  The support arms reach
           the rails from outside the part, but the tool body is 294.6 mm wide
           and sweeps past the part's +-y faces while it does so, so any floor
           plate inside the part's y thickness is hit by the tool body (measured:
           with the floor present, MoveIt reports
           gripper_left_finger_link/my_end_effector_link vs groove_floor from
           t = 8.4 s of the pre_grasp trajectory; with it removed, 0 of 46
           sampled states are in collision).  The grasp loads the rail inner
           faces, which is what the task actually does, so the floor adds
           collision without adding truth. -->


      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://cs625_task/shielding_module/meshes/shielding_module.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.72 0.45 0.18 1</ambient>
          <diffuse>0.72 0.45 0.18 1</diffuse>
        </material>
      </visual>

      <!-- Physical contact evidence for the insertion episode.  Same mechanism
           as the occluder and target sensors in the P7 worlds.  The original
           topic keeps watching the body; the rail gets its own topic so a grasp
           can be checked for "the support arm loaded the rail inner face"
           instead of "the tool pushed the housing body". -->
      <sensor name="module_contact" type="contact">
        <contact>
          <collision>body</collision>
        </contact>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/cs625_task/contacts/module</topic>
      </sensor>
      <sensor name="module_contact_rail" type="contact">
        <contact>
          <collision>rail</collision>
        </contact>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/cs625_task/contacts/module_rail</topic>
      </sensor>
    </link>
  </model>
</sdf>
