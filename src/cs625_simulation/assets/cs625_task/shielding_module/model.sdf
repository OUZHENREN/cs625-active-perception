<?xml version="1.0"?>
<!--
  Shielding-plate module (弹仓) for the CS625 insertion task.

  Frame: the SolidWorks part frame, unchanged by the export.  The mesh origin is
  NOT the centre of the part; the bounding box runs from (-0.4358, -0.0220,
  -0.2400) to (0.0188, 0.1090, 0.2250) m, and the centre of mass sits at
  (-0.2085, 0.0634, -0.0184) m.

  Mass properties come from the geometry, rescaled to the authoritative
  SolidWorks figures (19.0 kg over 3.0844e-3 m^3).  The effective density is
  6295 kg/m^3, which is not aluminium: the part contains shielding material.
  The tensor below is the uniform-density equivalent, computed with
  test/inspect_stl_mass_properties.py from the decimated mesh at that density.

  Collision is the bounding box.  The convex hull is 85% of the box volume, so
  the envelope is a close approximation of the outer shape and is far more
  stable for the wedge insertion than a concave mesh.  Replace it with a
  decomposition only if the slot contact must resolve the real wall thickness.
-->
<sdf version="1.9">
  <model name="shielding_module">
    <link name="shielding_module_link">
      <inertial>
        <pose>-0.208502 0.063361 -0.018444 0 0 0</pose>
        <mass>19.0</mass>
        <inertia>
          <ixx>3.983969590e-01</ixx>
          <ixy>1.171961458e-06</ixy>
          <ixz>2.749539088e-06</ixz>
          <iyy>7.426666580e-01</iyy>
          <iyz>3.706897912e-03</iyz>
          <izz>3.925590894e-01</izz>
        </inertia>
      </inertial>

      <collision name="envelope">
        <pose>-0.208500 0.043503 -0.007500 0 0 0</pose>
        <geometry>
          <box><size>0.4546 0.13099 0.4650</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://cs625_task/shielding_module/meshes/shielding_module.stl</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Physical contact evidence for the insertion episode.  Same mechanism
           as the occluder and target sensors in the P7 worlds. -->
      <sensor name="module_contact" type="contact">
        <contact>
          <collision>envelope</collision>
        </contact>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/cs625_task/contacts/module</topic>
      </sensor>
    </link>
  </model>
</sdf>
