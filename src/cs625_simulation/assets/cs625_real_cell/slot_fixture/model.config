<?xml version="1.0"?>
<model>
  <name>slot_fixture</name>
  <version>2.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>CS625 Active Perception</name>
  </author>
  <description>
    Real slot fixture (真机插槽夹具), converted from the RobotVisionSuite
    slot_pointcloud.STL scan to a 60,000-face metre-scale collision mesh.
