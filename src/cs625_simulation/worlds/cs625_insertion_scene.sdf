<?xml version="1.0"?>
<!--
  CS625 shielding-module insertion scene.

  The fixture model is expressed in the SolidWorks ASSEMBLY frame, and the
  seated module pose was measured in that same frame, so the assembly frame is
  placed here once and both parts keep their exported coordinates.

  Two placement facts were established from the geometry rather than guessed:

    - The arm's zero pose reaches along -X, so the task belongs at -X.  With the
      assembly frame nearly aligned to the world, the module's handles, which sit
      on assembly +X, then face the robot.  An earlier attempt put the fixture at
      +X and turned it 180 degrees about Y; that pointed the handles away and
      stood the fixture on its head.
    - The fixture as modelled is rotated 5.004 degrees about its own Y axis.  Its
      two 1878 cm^2 side faces are exactly normal to Y, so this is a rigid tilt of
      the whole part, not a modelling error, and the largest horizontal plate
      (947 cm^2) is what measures it.  Ry(-5.004 deg) levels that plate.  Some
      smaller faces stay off-axis, which is expected of a welded assembly.

  Assembly origin at world (-0.720, 0.000, 0.277737), RPY (0, -5.004 deg, 0):
    fixture  world X [-0.7382, -0.5382]  Y [-0.3725, 0.3725]  Z [0.0321, 0.5398] m
    module   world X [-0.7212, -0.5209]  Y [-0.2273, 0.2273]  Z [0.0200, 0.4910] m
             when seated

  The 32.1 mm stand-off is not decorative: when seated the module reaches 12.1 mm
  BELOW the fixture's mounting plane, so with the fixture flush on the floor the
  module would pass through it.  The stand-off leaves the module 20 mm clear.  If
  the real installation instead has a clearance hole in the bench, set the
  assembly origin Z to 0.245640 and say so.

  The module starts as a separate free body resting on the work surface, on the
  far side of the base from the fixture so the arm can pick it up and carry it
  across.  Both poses are recorded in cs625_bringup/config/cs625_task_scene.yaml,
  which is the authority for the task; keep the two in step when either changes.
-->
<sdf version="1.9">
  <world name="cs625_insertion_scene">
    <physics name="cs625_task_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 10 0.1</size></box></geometry>
        </collision>
        <sensor name="task_ground_contact" type="contact">
          <contact><collision>collision</collision></contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/cs625_task/contacts/ground</topic>
        </sensor>
        <visual name="visual">
          <geometry><box><size>10 10 0.1</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wedge slot fixture, static, in the SolidWorks assembly frame. -->
    <include>
      <uri>model://cs625_task/slot_fixture</uri>
      <name>slot_fixture</name>
      <static>true</static>
      <pose>-0.720000000 0.000000000 0.277737000 0.000000000 -0.087336276 0.000000000</pose>
    </include>

    <!-- Shielding module, initial pose: resting on the work surface. -->
    <include>
      <uri>model://cs625_task/shielding_module</uri>
      <name>shielding_module</name>
      <pose>0.450000000 0.450000000 0.248593000 -0.087336276 -0.000000000 1.570796327</pose>
    </include>
  </world>
</sdf>
