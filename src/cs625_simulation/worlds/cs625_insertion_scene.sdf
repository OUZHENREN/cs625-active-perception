<?xml version="1.0"?>
<!--
  CS625 shielding-module insertion scene.

  The fixture model is expressed in the SolidWorks ASSEMBLY frame, and the
  seated module pose was measured in that same frame, so the assembly frame is
  placed here once and both parts keep their exported coordinates.

  Orientation matters and cost one iteration to get right.  The assembly frame is
  rotated 180 degrees about world Y, which does two things at once:

    - the module's handles sit on its own -Y face, which maps to assembly +X, so
      without the turn they faced away from the robot.  After Ry(180) assembly +X
      points to world -X and the fixture opens toward the base at the origin.
    - assembly +Z points down.  Before the turn the module protruded 19.3 mm below
      the fixture, i.e. through the floor; after it, the module protrudes 19.3 mm
      above the fixture top, which is what an inserted module does.

  Assembly origin at world (0.720, 0.000, 0.260709):
    fixture  world X [0.5175, 0.7495]  Y [-0.3725, 0.3725]  Z [0.0000, 0.5058] m
    module   world X [0.5250, 0.7039]  Y [-0.2273, 0.2273]  Z [0.0490, 0.5251] m
             when seated, i.e. 19.3 mm proud of the fixture top

  The module starts as a separate free body resting on the work surface.  Both
  poses are recorded in cs625_bringup/config/cs625_task_scene.yaml, which is the
  authority for the task; keep the two in step when either changes.
-->
<sdf version="1.9">
  <world name="cs625_insertion_scene">
    <physics name="cs625_task_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 10 0.1</size></box></geometry>
        </collision>
        <sensor name="task_ground_contact" type="contact">
          <contact><collision>collision</collision></contact>
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/cs625_task/contacts/ground</topic>
        </sensor>
        <visual name="visual">
          <geometry><box><size>10 10 0.1</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wedge slot fixture, static, in the SolidWorks assembly frame. -->
    <include>
      <uri>model://cs625_task/slot_fixture</uri>
      <name>slot_fixture</name>
      <static>true</static>
      <pose>0.720 0.000 0.260709 0 3.14159265358979 0</pose>
    </include>

    <!-- Shielding module, initial pose: resting on the work surface. -->
    <include>
      <uri>model://cs625_task/shielding_module</uri>
      <name>shielding_module</name>
      <pose>0.550 -0.450 0.225 3.14159265358979 0 1.57079632679490</pose>
    </include>
  </world>
</sdf>
