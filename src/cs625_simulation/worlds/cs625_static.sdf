      <link name="tlink"><sensor name="tcam" type="rgbd_camera"><camera><horizontal_fov>1.0</horizontal_fov><image><width>64</width><height>64</height></image><clip><near>0.1</near><far>10</far></clip></camera><always_on>1</always_on><update_rate>1</update_rate><visualize>0</visualize><topic>/render_trigger</topic><gz_frame_id>tlink</gz_frame_id></sensor></link>
    </model>
    <!-- Static occlusion scene -->
