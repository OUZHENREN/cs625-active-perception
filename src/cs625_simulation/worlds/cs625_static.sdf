      <link name="link"><collision name="c"><geometry><box><size>0.35 1.6 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 1.6 1.5</size></box></geometry><material><ambient>0.15 0.15 0.65 1</ambient><diffuse>0.15 0.15 0.65 1</diffuse></material></visual></link>
    </model>
    <model name="target_object"><static>true</static><pose>0.95 0 0.4 0 0 0</pose>
