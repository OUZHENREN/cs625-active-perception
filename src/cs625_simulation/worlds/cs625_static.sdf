      <link name="link"><collision name="c"><geometry><box><size>10 10 0.1</size></box></geometry></collision><visual name="v"><geometry><box><size>10 10 0.1</size></box></geometry></visual></link>
    </model>
    <!-- Fixture camera as render-init trigger; keep at 64x64 1Hz, topic never bridged -->
