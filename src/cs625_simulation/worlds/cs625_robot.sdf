<?xml version="1.0"?>
<!--
  Minimal robot world: empty.sdf baseline + Sensors system (ogre2) +
  a low-res render-init trigger.  The CS625 robot with its eye-in-hand
  camera and gz_ros2_control plugin is spawned from robot_description.
  Occlusion geometry is not included here — add to simulation scenarios.
-->
<sdf version="1.6">
  <world name="cs625_robot">
    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Render-init trigger: a sensor must exist at world load for ogre2
         to initialize the render thread.  The eye-in-hand camera is
         spawned with the robot later. -->
    <model name="render_init_trigger">
      <static>true</static>
      <pose>-10.0 10.0 0.5 0 0 0</pose>
      <link name="trigger_link">
        <sensor name="trigger_cam" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>64</width><height>64</height></image>
            <clip><near>0.1</near><far>10.0</far></clip>
            <optical_frame_id>trigger_optical_frame</optical_frame_id>
          </camera>
          <always_on>1</always_on>
          <update_rate>1</update_rate>
          <visualize>false</visualize>
          <topic>/render_init_trigger</topic>
          <gz_frame_id>trigger_link</gz_frame_id>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
