<?xml version="1.0"?>
<!--
  Phase 1 robot world: a static occluder and target. The only RGB-D source in
  this world is the eye-in-hand sensor from the application robot Xacro.
-->
<sdf version="1.6">
  <world name="minimal_occlusion">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <!-- Sensors system intentionally omitted: the eye-in-hand camera is defined
         in the robot Xacro and registered at spawn time.  Including it here
         triggers ogre2 render-thread init at world load which stalls on headless
         GPU-path configurations.  The sensor added by the robot model will
         register its own rendering context. -->
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 10 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 10 0.1</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="occluder">
      <static>true</static>
      <pose>0.35 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 1.6 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 1.6 1.5</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.65 1</ambient>
            <diffuse>0.15 0.15 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_object">
      <static>true</static>
      <pose>0.95 0 0.4 0 0 0</pose>
      <link name="target_link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.1 0.1 1</ambient>
            <diffuse>0.75 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
