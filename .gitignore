# ROS 2 / colcon generated directories
build/
install/
log/
build_*/
install_*/
log_*/
.colcon/

# ROS runtime and bags
.ros/
*.bag
*.db3
*.mcap

# Python and editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.vscode/
.idea/

# Large generated simulation evidence. Commit summaries, JSON/CSV receipts and
# figures explicitly; keep raw captured frames and arrays in local archives.
docs/evidence/**/*.cdr
docs/evidence/**/*.npy
docs/evidence/**/*.ppm

# Local secrets and machine-specific configuration
*.local.yaml
*.local.yml
*.secret
